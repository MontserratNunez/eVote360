@using eVote360.Core.Application.ViewModels.AssignPosition

@model CreateAssignPositionViewModel
@{
    ViewData["Title"] = "Asignar Puesto";
}

<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-md-6">

            <div class="card card-modern shadow-sm">
                <div class="card-header pt-4">
                    <div class="text-center">
                        <h4 class="fw-bold mb-1">Nueva Asignación de Puesto</h4>
                        <p class="text-muted small m-1">Asocia un candidato disponible a un puesto electivo específico</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="CandidateId" class="form-label text-muted small fw-bold">Seleccionar Candidato:</label>
                            <select asp-for="CandidateId" class="form-select form-control-modern"
                                    asp-items="@(new SelectList(Model.Candidates, "Id", "Name"))">
                                <option value="">Seleccione un candidato</option>
                            </select>
                            <span asp-validation-for="CandidateId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ElectivePositionId" class="form-label text-muted small fw-bold">Puesto Electivo:</label>
                            <select asp-for="ElectivePositionId" class="form-select form-control-modern"
                                    asp-items="@(new SelectList(Model.Positions, "Id", "Name"))">
                                <option value="">Seleccione el puesto aspirado</option>
                            </select>
                            <span asp-validation-for="ElectivePositionId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-soft-orange">
                                <i class="bi bi-arrow-left-short"></i> Volver atrás
                            </a>
                            <button type="submit" class="btn btn-blue">
                                <i class="bi bi-floppy2"></i> Registrar Asignación
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
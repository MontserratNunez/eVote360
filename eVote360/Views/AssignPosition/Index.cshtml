@using eVote360.Core.Application.ViewModels.AssignPosition

@model AssignPositionIndexViewModel
@{
    ViewData["Title"] = "Asignación de Puestos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Asignación de Puestos Electivos</h2>
            <p class="page-subtitle">Listado de candidatos asignados a sus respectivos puestos de elección</p>
        </div>
        @if (!ViewBag.HasActiveElection)
        {
            <a class="btn btn-blue shadow-sm" asp-action="Create">
                <i class="bi bi-file-earmark-plus"></i> Asignar Puesto
            </a>
        }
    </div>

    @if (ViewBag.HasActiveElection)
    {
        <div class="alert alert-warning border-0 shadow-xs mb-3 d-inline-block p-2">
            <i class="bi bi-exclamation-triangle me-1"></i> No se pueden modificar puestos electivos mientras exista una elección activa.
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-xs alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-xs alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card card-modern shadow-sm mb-4">
        <div class="card-body">

            @if (Model.CurrentAssignments == null || Model.CurrentAssignments.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-person-workspace fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No hay puestos asignados a candidatos actualmente para el próximo proceso</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle m-0">
                        <thead>
                            <tr>
                                <th>Candidato</th>
                                <th>Partido Político</th>
                                <th>Puesto Asignado</th>
                                <th>Tipo de Candidatura</th>
                                @if (!ViewBag.HasActiveElection)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CurrentAssignments)
                            {
                                <tr>
                                    <td class="">@item.CandidateName @item.CandidateLastName</td>
                                    <td class="text-muted">@item.CandidatePartyName</td>
                                    <td class="text-muted">@item.PositionName</td>
                                    <td>
                                        @if (!item.IsAlliance)
                                        {
                                            <span class="badge rounded-pill badge-blue badge-role">@item.CandidateType</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-orange badge-role">@item.CandidateType</span>
                                        }
                                    </td>
                                    @if (!ViewBag.HasActiveElection)
                                    {
                                        <td class="text-end">
                                            @if (item.IsEditable)
                                            {
                                                <a class="btn btn-sm btn-danger" asp-action="ConfirmDelete" asp-route-id="@item.Id">
                                                    <i class="bi bi-trash"></i> Eliminar relación
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="accordion shadow-sm rounded card-modern overflow-hidden" id="accordionPastAssignments">
        <div class="accordion-item border-0">
            <h2 class="accordion-header" id="headingPast">
                <button class="accordion-button collapsed fw-bold text-dark bg-white py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePast" aria-expanded="false" aria-controls="collapsePast">
                    <i class="bi bi-archive text-secondary me-2"></i> Historial de Asignaciones
                    <span class="badge bg-light text-secondary rounded-pill ms-2 border">@Model.PastAssignments?.Count</span>
                </button>
            </h2>
            <div id="collapsePast" class="accordion-collapse collapse" aria-labelledby="headingPast" data-bs-parent="#accordionPastAssignments">
                <div class="accordion-body bg-white pt-0">

                    @if (Model.PastAssignments == null || Model.PastAssignments.Count == 0)
                    {
                        <div class="text-center p-4">
                            <i class="bi bi-folder-symlink fs-2 text-muted"></i>
                            <p class="mt-2 text-muted small">No se registran asignaciones de periodos anteriores.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mt-1">
                                <thead class="">
                                    <tr>
                                        <th>Candidato</th>
                                        <th>Partido Político</th>
                                        <th>Puesto Asignado</th>
                                        <th>Tipo de Candidatura</th>
                                        <th class="text-end">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PastAssignments)
                                    {
                                        <tr class="table-row-archived">
                                            <td class="text-secondary">@item.CandidateName @item.CandidateLastName</td>
                                            <td class="text-muted small">@item.CandidatePartyName</td>
                                            <td class="text-muted small">@item.PositionName</td>
                                            <td>
                                                <span class="badge rounded-pill bg-light text-secondary border px-2 py-1" style="font-size: 0.75rem;">
                                                    @item.CandidateType
                                                </span>
                                            </td>
                                            <td class="text-end text-muted small">
                                                <span class="badge bg-soft-secondary text-dark rounded-pill px-2"><i class="bi bi-lock-fill me-1"></i>Archivado</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<style>

    .accordion-button:not(.collapsed) {
        background-color: #fff !important;
        color: inherit !important;
        box-shadow: none !important;
        border-bottom: 1px solid #f1f1f1;
    }

    .accordion-button:focus {
        box-shadow: none !important;
        border-color: rgba(0,0,0,0.05);
    }

    .table-row-archived {
        background-color: rgba(248, 249, 250, 0.3);
    }

    .bg-soft-secondary {
        background-color: #e9ecef;
    }
</style>
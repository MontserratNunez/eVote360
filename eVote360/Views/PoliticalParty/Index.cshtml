@using eVote360.Core.Application.ViewModels.PoliticalParty
@model List<PoliticalPartyViewModel>;
@{
    ViewData["Title"] = "Partidos políticos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Partidos políticos</h2>
            <p class="page-subtitle">Listado de partidos políticos registrados</p>
        </div>
        @if (!ViewBag.HasActiveElection)
        {
            <a class="btn btn-blue shadow-sm" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> Crear partido político</a>
        }
    </div>

    @if (ViewBag.HasActiveElection)
    {
        <div class="alert alert-warning d-inline-block p-2">No se pueden modificar partidos políticos mientras exista una elección activa.</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card card-modern shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No hay partidos políticos registrados</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle">

                        <thead>
                            <tr>
                                <th>Foto</th>
                                <th>Siglas</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                @if (!ViewBag.HasActiveElection)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><img src="@item.LogoPath" class="rounded img-table responsive-image" alt="@item.Name"></td>
                                    <td class="fw-bold">@item.Acronym</td>
                                    <td>@item.Name</td>
                                    <td class="text-muted">@item.Description</td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Inactivo</span>
                                        }
                                    </td>

                                    @if (!ViewBag.HasActiveElection)
                                    {
                                        <td class="text-end">

                                            <a class="btn btn-sm btn-orange me-1" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i> Editar</a>

                                            @if (!item.Status)
                                            {
                                                <a class="btn btn-sm btn-success" asp-action="Activate" asp-route-id="@item.Id"><i class="bi bi-check-circle"></i> Activar</a>
                                            }

                                            @if (item.Status)
                                            {
                                                <a class="btn btn-sm btn-danger" asp-action="Deactivate" asp-route-id="@item.Id"><i class="bi bi-ban"></i> Desactivar</a>
                                            }

                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>


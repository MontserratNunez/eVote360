@model eVote360.Core.Application.ViewModels.CandidatePositionAssignment.DeleteCandidatePositionAssignmentViewModel

@{
    ViewData["Title"] = "Delete Candidate Position Assignment";
}

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Candidate Position Assignment</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this assignment?
                This action will only remove the relationship between the candidate and the position.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Candidate</dt>
                <dd class="col-sm-9">@Model.CandidateFullName</dd>

                <dt class="col-sm-3">Elective Position</dt>
                <dd class="col-sm-9">@Model.ElectivePositionName</dd>

                <dt class="col-sm-3">Political Party</dt>
                <dd class="col-sm-9">@Model.PoliticalPartyName</dd>
            </dl>

            <form asp-controller="CandidatePositionAssignment" asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CandidateFullName" />
                <input type="hidden" asp-for="ElectivePositionName" />
                <input type="hidden" asp-for="PoliticalPartyName" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="CandidatePositionAssignment" asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
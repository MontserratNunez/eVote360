@{
    Layout = "_LayoutAnonymous";
}

@model eVote360.Core.Application.ViewModels.Vote.VerifyCodeViewModel
@{
    ViewData["Title"] = "Verificación de Código";
}

<div class="container mt-5">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-shield-slash-fill me-2"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card card-modern shadow-sm border-0 mt-4">
                <div class="card-header pt-5 pb-3 bg-transparent border-0 text-center">
                    <div class="mb-3">
                        <i class="bi bi-envelope-check text-blue fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Código de Seguridad</h3>
                    <p class="text-muted small px-4">
                        Hemos enviado un código de verificación de un solo uso al correo electrónico asociado a tu usuario.
                    </p>
                </div>

                <div class="card-body p-4">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <form asp-action="VerifyCode" method="post">

                        <div class="mb-4">
                            <label asp-for="Code" class="form-label text-muted small fw-bold d-block text-center mb-3">
                                Ingrese el código recibido:
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Code"
                                       class="form-control form-control-modern text-center fw-bold fs-4 tracking-widest"
                                       placeholder="••••••"
                                       autocomplete="one-time-code"
                                       inputmode="numeric"
                                       maxlength="10"
                                       autofocus />
                            </div>
                            <span asp-validation-for="Code" class="text-danger small mt-2 d-block text-center"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-blue py-2 shadow-sm">
                                <i class="bi bi-shield-check me-2"></i> Confirmar y Acceder
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
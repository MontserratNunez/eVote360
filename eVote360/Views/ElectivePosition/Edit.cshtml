@using eVote360.Core.Application.ViewModels.ElectivePosition

@model EditPositionViewModel
@{
    ViewData["Title"] = "Editar Puesto Electivo";
}

<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-md-6">

            <div class="card card-modern shadow-sm">
                <div class="card-header pt-4">
                    <div class="text-center">
                        <h4 class="fw-bold mb-1">Editar puesto electivo</h4>
                        <p class="text-muted small m-1">Modifica la información del puesto electivo</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-muted small">Nombre:</label>

                            @if (ViewBag.HasParticipated != null && ViewBag.HasParticipated)
                            {
                                <input asp-for="Name" class="form-control" readonly />
                                <div class="form-text text-warning small mt-1">
                                    <i class="bi bi-exclamation-triangle-fill"></i><p class="text-muted">No se puede modificar porque ya participó en una elección.</p>
                                </div>
                            }
                            else
                            {
                                <input asp-for="Name" class="form-control">
                            }
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-muted small">Descripción:</label>
                            <input asp-for="Description" class="form-control">
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="Status" class="form-check-input" type="checkbox">
                            <label class="form-check-label">Puesto activo</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-soft-orange">
                                <i class="bi bi-arrow-left-short"></i> Volver atrás
                            </a>
                            <button type="submit" class="btn btn-blue">
                                <i class="bi bi-floppy2"></i> Guardar
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
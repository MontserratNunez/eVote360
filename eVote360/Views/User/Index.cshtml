@using eVote360.Core.Application.ViewModels.User
@using eVote360.Core.Domain.Common.Enums
@model List<UserViewModel>;
@{
    ViewData["Title"] = "Users";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Usuarios</h2>
            <p class="page-subtitle">Listado de usuarios registrados</p>
        </div>

        <a class="btn btn-blue shadow-sm" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> Crear usuario</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card card-modern shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No hay usuarios registrados</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle">

                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Email</th>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.Name</td>
                                    <td>@item.LastName</td>
                                    <td class="text-muted">@item.Email</td>
                                    <td>@item.UserName</td>

                                    <td>
                                        @if (item.Role == Role.ADMIN)
                                        {
                                            <span class="badge rounded-pill badge-blue badge-role">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-orange badge-role">Dirigente</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Inactivo</span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a class="btn btn-sm btn-orange me-1" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i> Editar</a>

                                        @if (!item.Status)
                                        {
                                            <a class="btn btn-sm btn-success" asp-action="Activate" asp-route-id="@item.Id"><i class="bi bi-check-circle"></i> Activar</a>
                                        }

                                        @if (item.Status)
                                        {
                                            <a class="btn btn-sm btn-danger" asp-action="Deactivate" asp-route-id="@item.Id"><i class="bi bi-ban"></i> Desactivar</a>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
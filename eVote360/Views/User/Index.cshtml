@using eVote360.Core.Application.ViewModels.User
@model List<UserViewModel>;
@{
    ViewData["Title"] = "Users";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Usuarios</h2>
            <p class="text-muted">Listado de usuarios registrados.</p>
        </div>
        <a class="btn btn-outline-success" asp-controller="User" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> New user</a>
        <a asp-action="Create" class="btn btn-primary">
            + Crear usuario
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    <p>No hay usuarios registrados</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Correo electrónico</th>
                                <th>Nombre de usuario</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.LastName</td>
                                    <td>@item.Email</td>
                                    <td>@item.UserName</td>
                                    <td>
                                        @if (item.Role == 1)
                                        {
                                            <span class="badge bg-primary">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Dirigente</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-warning float-end" asp-controller="User" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i> Editar</a>
                                        <a class="btn btn-danger float-end me-2" asp-controller="User" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i> Eliminar</a>
                                        @if (item.Status)
                                        {
                                            <a class="btn btn-outline-danger float-end me-2" asp-controller="User" asp-action="Deactivate" asp-route-id="@item.Id"><i class="bi bi-ban"></i> Desactivar</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
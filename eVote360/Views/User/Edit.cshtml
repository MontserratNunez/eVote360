@using eVote360.Core.Application.ViewModels.User

@model UpdateUserViewModel
@{
    ViewData["Title"] = "Edit User";
}



<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-md-6">

            <div class="card shadow-sm">

                <div class="card-header pt-4">
                    <div class="text-center">
                        <h4 class="fw-bold mb-1">Editar usuario</h4>
                        <p class="text-muted small m-1">Editar la información del usuario</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-muted small">Nombre:</label>
                            <input asp-for="Name" class="form-control">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label text-muted small">Apellido:</label>
                            <input asp-for="LastName" class="form-control">
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted small">Email:</label>
                            <input asp-for="Email" class="form-control">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label text-muted small">UserName:</label>
                            <input asp-for="UserName" class="form-control">
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-muted small">Password:</label>
                            <input asp-for="Password" type="password" class="form-control">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-muted small">Confirm password:</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="Status" class="form-check-input" type="checkbox" checked>
                            <label class="form-check-label">Usuario activo</label>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small">Rol</label>
                            <select asp-for="Role" class="form-select form-control-modern">
                                <option value="1">Administrador</option>
                                <option value="2">Dirigente</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-soft-orange"><i class="bi bi-arrow-left-short"></i> Volver atrás</a>
                            <button type="submit" class="btn btn-blue"><i class="bi bi-floppy2"></i> Guardar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


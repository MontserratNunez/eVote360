@model List<eVote360.Core.Application.ViewModels.Citizen.CitizenViewModel>

@{
    ViewData["Title"] = "Ciudadanos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Ciudadanos</h2>
            <p class="page-subtitle">Listado de ciudadanos registrados</p>
        </div>

            @if (!ViewBag.HasActiveElection)
            {
            <a asp-action="Create" class="btn btn-blue shadow-sm"><i class="bi bi-file-earmark-plus"></i> Crear ciudadano</a>
            }
        </div>

            @if (ViewBag.HasActiveElection)
            {
                <div class="alert alert-warning d-inline-block p-2">No se pueden modificar ciudadanos mientras exista una elección activa.</div>
            }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

    <div class="card card-modern shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No hay ciudadanos registrados</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle">

                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Correo electrónico</th>
                                <th>Documento</th>
                                <th>Estado</th>
                                @if (!ViewBag.HasActiveElection)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.LastName</td>
                                    <td class="text-muted">@item.Email</td>
                                    <td>@item.DocumentNumber</td>
                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Inactivo</span>
                                        }
                                    </td>
                                    @if (!ViewBag.HasActiveElection)
                                    {
                                        <td class="text-end">

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-orange me-1"> <i class="bi bi-pencil-square"></i>Editar</a>

                                            @if (!item.Status)
                                            {
                                                <a class="btn btn-sm btn-success" asp-action="Confirm" asp-route-id="@item.Id" asp-route-activate="true"><i class="bi bi-check-circle"></i> Activar</a>
                                            }

                                            @if (item.Status)
                                            {
                                                <a class="btn btn-sm btn-danger" asp-action="Confirm" asp-route-id="@item.Id" asp-route-activate="false"><i class="bi bi-ban"></i> Desactivar</a>
                                            }

                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
@using eVote360.Core.Application.ViewModels.LeaderAssignment

@model List<LeaderAssignmentViewModel>
@{
    ViewData["Title"] = "Asignación de Dirigentes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Asignación de Dirigentes</h2>
            <p class="page-subtitle">Listado de usuarios asignados a partidos políticos</p>
        </div>
        @if (!ViewBag.HasActiveElection)
        {
            <a class="btn btn-blue shadow-sm" asp-action="Create">
                <i class="bi bi-file-earmark-plus"></i> Asignar Dirigente
            </a>
        }
    </div>

    @if (ViewBag.HasActiveElection)
    {
        <div class="alert alert-warning d-inline-block p-2">No se pueden modificar dirigentes políticos mientras exista una elección activa.</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card card-modern shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-person-lines-fill fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No hay asignaciones de dirigentes registradas</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle">
                        <thead>
                            <tr>
                                <th>Dirigente</th>
                                <th>Usuario</th>
                                <th>Estado Usuario</th>
                                <th>Partido Político</th>
                                <th>Estado Partido</th>
                                @if (!ViewBag.HasActiveElection)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="">@item.FullName</td>
                                    <td class="text-muted">@item.UserName</td>
                                    <td>
                                        @if (item.UserStatus)
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="">@item.PartyName</span>
                                        <span class="text-muted small">(@item.PartyAcronym)</span>
                                    </td>
                                    <td>
                                        @if (item.PartyStatus)
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Inactivo</span>
                                        }
                                    </td>
                                    @if (!ViewBag.HasActiveElection)
                                    {
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-danger" asp-action="Confirm" asp-route-id="@item.Id">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
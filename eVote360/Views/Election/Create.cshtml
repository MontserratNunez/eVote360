@using eVote360.Core.Application.ViewModels.Election

@model CreateElectionViewModel
@{
    ViewData["Title"] = "Nueva Elección";
}

<div class="container mt-4">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger border-0 alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-md-6">

            <div class="card card-modern shadow-sm">
                <div class="card-header pt-4">
                    <div class="text-center">
                        <h4 class="fw-bold mb-1">Nueva Elección</h4>
                        <p class="text-muted small m-1">Apertura un nuevo proceso o jornada electoral</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-muted small fw-bold">Nombre del Proceso:</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Elecciones Presidenciales 2026">
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Date" class="form-label text-muted small fw-bold">Fecha de Celebración:</label>
                            <input asp-for="Date" type="date" class="form-control">
                            <span asp-validation-for="Date" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-soft-orange">
                                <i class="bi bi-arrow-left-short"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-blue">
                                <i class="bi bi-floppy2"></i>  Crear elección
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
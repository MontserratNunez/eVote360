@using eVote360.Core.Application.ViewModels.PoliticalAlliance


@model List<PoliticalAllianceViewModel>
@{
    ViewData["Title"] = "Solicitudes Realizadas";
    ViewData["ActiveTab"] = "All";
}

<div class="container mt-4">
    <partial name="_AllianceNavbar" view-data="ViewData" />

    <div class="card card-modern shadow-sm border-top-0 rounded-top-0">
        <div class="card-body">

            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-send-x fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">No has realizado ninguna solicitud de alianza.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern align-middle">
                        <thead>
                            <tr>
                                <th>Partido destino</th>
                                <th>Fecha de solicitud</th>
                                <th>Estado</th>
                                @if (!ViewBag.HasActiveElection)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.PartyName</td>
                                    <td class="text-muted">@item.RequestDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>
                                        @if (item.StatusText == "Aceptada")
                                        {
                                            <span class="badge rounded-pill badge-active badge-status">Aceptada</span>
                                        }
                                        else if (item.StatusText == "Rechazada")
                                        {
                                            <span class="badge rounded-pill badge-inactive badge-status">Rechazada</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill badge-orange badge-status">En espera de respuesta</span>
                                        }
                                    </td>
                                    @if (!ViewBag.HasActiveElection)
                                    {
                                        <td class="text-end">
                                            @if (item.StatusText == "En espera de respuesta" || item.StatusText == "Rechazada")
                                            {
                                                <a class="btn btn-sm btn-danger" asp-action="ConfirmDeleteRequest" asp-route-id="@item.Id">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">-</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
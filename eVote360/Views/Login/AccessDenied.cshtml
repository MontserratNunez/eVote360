@{
    ViewData["Title"] = "Access denied";
    var controller = ViewBag.Controller ?? "Login";
}


<div class="d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 60vh;">

    <i class="bi bi-shield-lock text-danger mb-3" style="font-size: 3rem;"></i>

    <h1 class="fw-bold mb-2">Acceso denegado</h1>

    <p class="text-muted mb-4">No tienes permisos para acceder a esta sección.</p>


<a asp-controller="@controller" asp-action="Index" class="btn btn-orange"><i class="bi bi-house-door"></i> Home</a>
</div>
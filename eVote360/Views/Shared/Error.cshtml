    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    Layout = "_Layout";
}


<div class="d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 70vh;">

    <h1 class="error-code mb-2">@ViewBag.Code</h1>

    <h3 class="fw-bold mb-2">@ViewBag.Title</h3>

    <p class="text-muted mb-4" style="max-width: 400px;">
        @ViewBag.Text
    </p>

    <a href="/" class="btn btn-orange">
        <i class="bi bi-house-door"></i> Volver al inicio
    </a>

</div>

<style>
    .error-code {
        font-size: 6rem;
        font-weight: 800;
        color: #9c9d9d;
        line-height: 1;
        letter-spacing: -2px;
    }

</style>